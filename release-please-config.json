{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/octo_bed/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "custom_components/octo_bed/manifest.json",
          "jsonpath": "$.requirements[?(@.match && @.match(/^octo-bed-protocol==/))]"
        },
        {
          "type": "generic",
          "path": "lib/octo_bed_protocol/pyproject.toml"
        }
      ]
    }
  }
}
